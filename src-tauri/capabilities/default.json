{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local app window, user-chosen file dialogs, and app updates",
  "windows": ["main"],
  "permissions": ["core:default", "core:window:allow-destroy", "dialog:allow-open", "dialog:allow-save", "dialog:allow-ask", "updater:default", "process:allow-restart"]
}
