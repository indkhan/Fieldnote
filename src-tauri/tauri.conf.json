{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Research",
  "version": "0.2.0",
  "identifier": "io.moneo.research",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Research",
        "width": 1020,
        "height": 780,
        "minWidth": 620,
        "minHeight": 560,
        "backgroundColor": "#0f1011",
        "theme": "Dark",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/audio/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Local sessions, questionnaires, and audio",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
