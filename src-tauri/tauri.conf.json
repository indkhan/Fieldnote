{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fieldnote",
  "version": "0.4.0",
  "identifier": "io.github.indkhan.fieldnote",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fieldnote",
        "width": 1020,
        "height": 780,
        "minWidth": 620,
        "minHeight": 560,
        "backgroundColor": "#0f1011",
        "theme": "Dark",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/audio/**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEOEEwN0NCMDU4MDQ5RDkKUldUWlNZQUZ5d2VLcmVudlRkaTkzai9leWVqZEQ5aVNnNlVkWkx3d3RQVmJRWWloZE5ibUdYSFkK",
      "endpoints": [
        "https://github.com/indkhan/Fieldnote/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "dmg",
      "app",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Notes, questions, and recordings from your conversations",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
